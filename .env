# Copier ce fichier en .env et renseigner les valeurs du projet Supabase
# (Supabase > Project Settings > API). Sans ces valeurs, l'app tourne avec des données factices.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Script d'import Google Places (npm run import:places). Ces clés ne vont JAMAIS dans l'app :
# n'ajoutez pas le préfixe EXPO_PUBLIC_, sinon elles seraient embarquées dans le bundle.
GOOGLE_PLACES_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
